# Football Intelligence API 环境变量样例
# 复制为 .env 或在启动环境中设置

# ---- 数据源 ----
# mock: 本地确定性模拟引擎（默认，零依赖）
# api_football: 真实数据源 https://www.api-football.com（免费档每天 100 次）
DATA_PROVIDER=mock
API_FOOTBALL_KEY=

# ---- 数据库 ----
# 开发默认 SQLite；生产示例:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/football_intel

# ---- WebSocket ----
WS_PUSH_INTERVAL=5

# ---- AI 报告（可选，OpenAI 兼容接口）----
# 未配置时使用内置数据驱动模板引擎
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
